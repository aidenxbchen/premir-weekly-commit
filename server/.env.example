PORT=3000

FEISHU_APP_ID=cli_aa840243e779dcb1
FEISHU_APP_SECRET=

# Any long random string; used to sign session JWTs.
SESSION_SECRET=

# Bitable app_token (the part after /base/ in the Base's URL).
# Use the dev-copy token while testing locally; switch to the production
# token only when you're ready to go live.
BASE_TOKEN=

# Table IDs inside BASE_TOKEN — see README for how to find these
# (lark-cli base +table-list --base-token <BASE_TOKEN>).
TABLE_ID_MILESTONES=
TABLE_ID_RATINGS=
TABLE_ID_WASH=
TABLE_ID_DRY=
TABLE_ID_IRON=
TABLE_ID_WATER=
TABLE_ID_SOFTWARE=
